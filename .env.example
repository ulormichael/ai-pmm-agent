# --- Required ---
OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=            # optional; leave blank to use the SDK default

# --- Email (leave blank to run in safe MOCK mode: no real emails are sent) ---
EMAIL_ADDRESS=becky@yourdomain.com
EMAIL_FROM_NAME=Becky (AI Assistant)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=becky@yourdomain.com
SMTP_PASS=your_app_password
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=becky@yourdomain.com
IMAP_PASS=your_app_password

# --- Safety ---
# Comma-separated. If set, Becky can only email these domains/addresses (even after you approve).
EMAIL_ALLOWED_RECIPIENTS=
# Hard cap on emails sent per session
EMAIL_MAX_PER_SESSION=20
# Optional signature appended to every outgoing email
EMAIL_SIGNATURE=

# --- HTTP API (npm run serve) ---
BECKY_API_TOKEN=change_me_to_a_long_random_string
PORT=3001
HOST=127.0.0.1
# The one frontend origin allowed to call the API (your React dev server)
ALLOWED_ORIGIN=http://localhost:5173
